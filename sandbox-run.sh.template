#!/usr/bin/env bash
set -euo pipefail

ROOTFS="$(realpath ./rootfs)"
TARGET="$(realpath "${1:?usage: sudo ./sandbox-run <job.sh>}")"

# 在 unshare 前记录宿主 namespace，供 job.sh 在盒内安全地比较。
SAST_HOST_UTS_NS="$(readlink /proc/self/ns/uts)"
SAST_HOST_PID_NS="$(readlink /proc/self/ns/pid)"
SAST_HOST_MNT_NS="$(readlink /proc/self/ns/mnt)"

if (( EUID != 0 )); then
    echo "please run this script with sudo" >&2
    exit 1
fi

if [[ ! -d "${ROOTFS}" ]]; then
    echo "rootfs not found: ${ROOTFS}" >&2
    exit 1
fi

